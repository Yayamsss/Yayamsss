CREATE TABLE AppMeta (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TABLE Repository (
  url TEXT NOT NULL PRIMARY KEY,
  name TEXT,
  addedAt INTEGER NOT NULL
);

CREATE TABLE InstalledPlugin (
  pluginId TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  site TEXT NOT NULL,
  lang TEXT NOT NULL,
  version TEXT NOT NULL,
  url TEXT NOT NULL,
  iconUrl TEXT,
  repoUrl TEXT NOT NULL,
  installedAt INTEGER NOT NULL
);

CREATE TABLE LibraryNovel (
  pluginId TEXT NOT NULL,
  novelPath TEXT NOT NULL,
  name TEXT NOT NULL,
  cover TEXT,
  addedAt INTEGER NOT NULL,
  knownChapterCount INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (pluginId, novelPath)
);

CREATE TABLE HistoryEntry (
  pluginId TEXT NOT NULL,
  novelPath TEXT NOT NULL,
  novelName TEXT NOT NULL,
  chapterPath TEXT NOT NULL,
  chapterName TEXT NOT NULL,
  readAt INTEGER NOT NULL,
  PRIMARY KEY (pluginId, chapterPath)
);

selectAppMeta:
SELECT value
FROM AppMeta
WHERE key = ?;

upsertAppMeta:
INSERT OR REPLACE INTO AppMeta(key, value)
VALUES (?, ?);

selectRepositories:
SELECT *
FROM Repository
ORDER BY addedAt ASC;

selectRepository:
SELECT *
FROM Repository
WHERE url = ?;

upsertRepository:
INSERT OR REPLACE INTO Repository(url, name, addedAt)
VALUES (?, ?, ?);

deleteRepository:
DELETE FROM Repository
WHERE url = ?;

selectInstalledPlugins:
SELECT *
FROM InstalledPlugin
ORDER BY name COLLATE NOCASE ASC;

selectInstalledPlugin:
SELECT *
FROM InstalledPlugin
WHERE pluginId = ?;

upsertInstalledPlugin:
INSERT OR REPLACE INTO InstalledPlugin(
  pluginId,
  name,
  site,
  lang,
  version,
  url,
  iconUrl,
  repoUrl,
  installedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteInstalledPlugin:
DELETE FROM InstalledPlugin
WHERE pluginId = ?;

selectLibraryNovels:
SELECT *
FROM LibraryNovel
ORDER BY addedAt DESC;

selectLibraryNovel:
SELECT *
FROM LibraryNovel
WHERE pluginId = ? AND novelPath = ?;

upsertLibraryNovel:
INSERT OR REPLACE INTO LibraryNovel(
  pluginId,
  novelPath,
  name,
  cover,
  addedAt,
  knownChapterCount
)
VALUES (?, ?, ?, ?, ?, ?);

updateLibraryNovelMetadata:
UPDATE LibraryNovel
SET name = ?, cover = ?, knownChapterCount = ?
WHERE pluginId = ? AND novelPath = ?;

updateKnownChapterCount:
UPDATE LibraryNovel
SET knownChapterCount = ?
WHERE pluginId = ? AND novelPath = ?;

deleteLibraryNovel:
DELETE FROM LibraryNovel
WHERE pluginId = ? AND novelPath = ?;

selectHistoryEntries:
SELECT *
FROM HistoryEntry
ORDER BY readAt DESC;

upsertHistoryEntry:
INSERT OR REPLACE INTO HistoryEntry(
  pluginId,
  novelPath,
  novelName,
  chapterPath,
  chapterName,
  readAt
)
VALUES (?, ?, ?, ?, ?, ?);
